# Database
POSTGRES_DB=pdf_processing
POSTGRES_USER=pdf_user
POSTGRES_PASSWORD=pdf_password
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=pdf_user
RABBITMQ_PASSWORD=pdf_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# API Gateway
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Worker
DOTNET_ENVIRONMENT=Development

# OCRBase (optional - leave empty to use PdfPig only)
# https://ocrbase.dev — OCR-as-a-service API
# Get your API key at https://ocrbase.dev/app
OCRBASE_API_KEY=
